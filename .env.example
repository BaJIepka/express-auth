NODE_ENV=development
PORT=3000

# MySQL (used by docker-compose to provision the database)
MYSQL_DATABASE=express_auth
MYSQL_USER=express_auth
MYSQL_PASSWORD=express_auth
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

DATABASE_URL="mysql://express_auth:express_auth@localhost:3306/express_auth"

# Valkey (Redis-compatible)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_DURATION=15
