{
  "info": {
    "_postman_id": "b6f2b6a0-4b1d-4b9e-9c3a-express-auth-collection",
    "name": "Express Auth API",
    "description": "Коллекция для проверки REST API авторизации (register/login/refresh/logout/me/change-password).\n\nКак запускать:\n- Через Collection Runner сверху вниз (Run collection) — папки 1 и 4 создают собственных пользователей и сохраняют токены в переменных коллекции для последующих шагов.\n- Папка \"2. Validation Errors\" полностью самодостаточна (не зависит от других папок).\n- Папка \"3. Security\" содержит свой Setup-запрос и в основном самодостаточна; запрос \"Refresh - Reuse Consumed Token\" зависит от папки 1 (использует refresh-токен, потреблённый шагом 1.4).\n- Папка \"5. Conflict\" зависит от папки 1 (использует уже зарегистрированный email).\n\nПеред запуском поднимите сервер: `docker compose up --build` (или `npm run dev` локально) — сервер должен слушать `http://localhost:3000`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "testEmail", "value": "", "type": "string" },
    { "key": "testPassword", "value": "Password123", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "oldRefreshToken", "value": "", "type": "string" },
    { "key": "secUserEmail", "value": "", "type": "string" },
    { "key": "secUserPassword", "value": "Password123", "type": "string" },
    { "key": "secAccessToken", "value": "", "type": "string" },
    { "key": "bruteEmail", "value": "", "type": "string" },
    { "key": "brutePassword", "value": "Password123", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Happy Path & Session Lifecycle",
      "item": [
        {
          "name": "1.1 Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `user_${Date.now()}_${Math.floor(Math.random() * 100000)}@example.com`;",
                  "pm.collectionVariables.set('testEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns user and tokens, no password field', function () {",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.data.user.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "  pm.expect(json.data.user).to.not.have.property('password');",
                  "  pm.expect(json.data.accessToken).to.be.a('string');",
                  "  pm.expect(json.data.refreshToken).to.be.a('string');",
                  "});",
                  "",
                  "pm.collectionVariables.set('userId', String(json.data.user.id));",
                  "pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Иван Иванов\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Login",
